# =========================================================
# Lokesh Portfolio — Backend Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to Git (it is in .gitignore).
# =========================================================

# ---- DATABASE ----
# Local development (default):
MONGO_URI=mongodb://localhost:27017
# Production: Replace with your MongoDB Atlas free M0 connection string.
# Atlas URI format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# See README "Deploying to Vercel" for full instructions.

DB_NAME=portfolio_db

# ---- SECURITY ----
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# ---- ADMIN BOOTSTRAP ----
# Credentials used by seed_admin.py to create the first admin user.
# Change these before running seed_admin.py for the first time.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=YourSecurePassword!

# ---- UPLOADS ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---- CORS ----
# REMINDER: After deploying the frontend, add its real URL here.
# Example: ALLOWED_ORIGINS=https://yourname.vercel.app,http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- CLOUDINARY (image hosting) ----
# Sign up for a free account at https://cloudinary.com (no credit card required).
# Find these values in your Cloudinary Dashboard under "API Keys".
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- RESEND (email for admin reply feature) ----
# Sign up at https://resend.com (free tier: 3,000 emails/month).
# Create an API key in the Resend dashboard and paste it below.
# FROM_EMAIL must be a verified sender domain in your Resend account.
# Until you verify a domain, you can use onboarding@resend.dev for testing.
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=onboarding@resend.dev
